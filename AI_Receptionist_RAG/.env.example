PORT=9000
NODE_ENV=development

# Allowed Backend Origins (comma-separated for multiple)
# Docker Compose: BACKEND_URL=http://api_backend:5000,http://localhost:8000,http://localhost:5173
# Render Prod:   BACKEND_URL=https://akuh-api-backend.onrender.com
BACKEND_URL=http://localhost:5000,http://localhost:8000,http://localhost:5173

# ChromaDB Vector Database (cloud hosted on api.trychroma.com)
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_uuid
CHROMA_DATABASE=AKUH_Agent
CHROMA_COLLECTION_NAME=akuh-rag

# Google GenAI (for embeddings via LangChain)
GOOGLE_API_KEY=your_google_api_key_here

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
