PORT=8000
NODE_ENV=development

# MongoDB Connection
DB_URL=mongodb://localhost:27017/AI_Receptionist
# For Render/Production use: DB_URL=mongodb+srv://user:pass@cluster.mongodb.net/AI_Receptionist

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRY=5d

# Allowed Frontend Origins (comma-separated for multiple)
FRONTEND_URL=http://localhost:8000,http://localhost:5173

# RAG Backend Service URL
# Docker Compose: RAG_API_URL=http://rag_backend:9000
# Local Dev:     RAG_API_URL=http://localhost:9000
# Render Prod:   RAG_API_URL=https://akuh-rag-backend.onrender.com
RAG_API_URL=http://localhost:9000
