# ─────────────────────────────────────────────────────────────────
# Frontend Environment Variables
# NOTE: Vite env vars MUST start with VITE_ to be exposed to client code
# NOTE: These are read at BUILD TIME and BAKED into the JavaScript bundle.
#       Re-run `npm run build` after changing any of these.
# ─────────────────────────────────────────────────────────────────

# For Local Docker Compose (Nginx reverse proxy on :8000):
#   VITE_API_BASE_URL=/api/akuh
#   VITE_RAG_API_BASE_URL=/api/rag
#
# For Vercel Production (services deployed separately on Render):
#   VITE_API_BASE_URL=https://akuh-api-backend.onrender.com
#   VITE_RAG_API_BASE_URL=https://akuh-rag-backend.onrender.com

VITE_API_BASE_URL=/api/akuh
VITE_RAG_API_BASE_URL=/api/rag
VITE_GOOGLE_CLIENT_ID=292028013556-n3q1re8hdg8ak2au9ldv4cvaqog62enb.apps.googleusercontent.com
